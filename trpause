#!/usr/bin/env python3
"""Pause (freeze) or resume the C64 via DMA (TR+ only).

usage: trpause [-r] [-H HOST[:PORT]]     -r resumes
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from trlib import TR, TRError, parse_target, split_host, parse_int  # noqa: E402

HOSTHELP = "host[:port] (required unless $TR_HOST is set; port defaults to 2112)"


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("-r", "--resume", action="store_true")
    ap.add_argument("-H", "--host", help=HOSTHELP)
    a = ap.parse_args()
    try:
        with TR(*split_host(a.host)) as tr:
            tr.pause(not a.resume)
    except TRError as e:
        print(f"trpause: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
