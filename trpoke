#!/usr/bin/env python3
"""Write C64 memory via DMA (TR+ only).

usage: trpoke [-H HOST[:PORT]] ADDR BYTE [BYTE ...]     e.g. trpoke $d020 2   (border red)
       trpoke [-H HOST[:PORT]] -f FILE ADDR             write a file ("-" = stdin) at ADDR
Numbers: 1024, 0x400 or $400.
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from trlib import TR, TRError, parse_target, split_host, parse_int  # noqa: E402

HOSTHELP = "host[:port] (required unless $TR_HOST is set; port defaults to 2112)"


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("addr")
    ap.add_argument("bytes", nargs="*")
    ap.add_argument("-f", "--file")
    ap.add_argument("-H", "--host", help=HOSTHELP)
    a = ap.parse_args()
    try:
        addr = parse_int(a.addr)
        if a.file:
            data = sys.stdin.buffer.read() if a.file == "-" else open(a.file, "rb").read()
        else:
            vals = [parse_int(b) for b in a.bytes]
            if not vals or any(not 0 <= v <= 255 for v in vals):
                raise ValueError("give one or more byte values 0-255, or -f FILE")
            data = bytes(vals)
        with TR(*split_host(a.host)) as tr:
            tr.write_mem(addr, data)
    except (ValueError, OSError, TRError) as e:
        print(f"trpoke: {e}", file=sys.stderr)
        return 1
    print(f"wrote {len(data)} bytes at ${addr:04x}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
