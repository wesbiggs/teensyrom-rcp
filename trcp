#!/usr/bin/env python3
"""Copy a file on the TeensyROM+ itself (no data crosses the network).

usage: trcp [-H HOST[:PORT]] [drive:]/src [drive:]/dst     e.g. trcp sd:/a.prg sd:/Backup/a.prg
Both paths must be on the same drive. Missing destination folders are created; an
existing destination is overwritten. A destination ending in / keeps the file name.
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from trlib import TR, TRError, parse_target, split_host, parse_int  # noqa: E402

HOSTHELP = "host[:port] (required unless $TR_HOST is set; port defaults to 2112)"


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("src")
    ap.add_argument("dst")
    ap.add_argument("-H", "--host", help=HOSTHELP)
    a = ap.parse_args()
    d1, src = parse_target(a.src)
    d2, dst = parse_target(a.dst, default_drive=d1)
    if d1 != d2:
        print("trcp: source and destination must be on the same drive", file=sys.stderr)
        return 1
    if dst.endswith("/"):
        dst += os.path.basename(src)
    try:
        with TR(*split_host(a.host)) as tr:
            tr.copy_file(d1, src, dst)
    except TRError as e:
        print(f"trcp: {e}", file=sys.stderr)
        return 1
    print(f"{d1}:{src} -> {d1}:{dst}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
