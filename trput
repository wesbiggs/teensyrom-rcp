#!/usr/bin/env python3
"""Upload files to a TeensyROM+ SD card or USB drive over TCP.

usage: trput [-f] [-H HOST[:PORT]] local_file... [drive:]/remote/path     e.g. trput *.prg usb:
A remote path ending in '/' (or '/' alone, or a bare 'usb:') keeps the local file names, and is required
when sending several files. Missing remote directories are created by the TR. The TR refuses to
overwrite an existing file; -f deletes it first. A failed file is reported and the rest still go.
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from trlib import TR, TRError, parse_target  # noqa: E402


def put(tr, drive, path, data, force):
    """Upload; with force, a refusal for an existing file deletes it and tries again. Asking the TR
    (rather than checking a listing first) also covers names that differ only in case (FAT is
    case-insensitive) and hidden dotfiles, which directory listings omit."""
    try:
        return tr.put_file(drive, path, data)
    except TRError as e:
        if not force or "already exists" not in str(e):
            raise
    tr.reconnect()
    tr.delete_file(drive, path)
    return tr.put_file(drive, path, data)


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0],
                                 usage="%(prog)s [-h] [-H HOST] [-f] local_file... remote")
    ap.add_argument("paths", nargs="+", metavar="path",
                    help="local files ('-' reads stdin), then the destination [sd|usb:]/path/or/dir/")
    ap.add_argument("-H", "--host", help="host[:port] (required unless $TR_HOST is set; port defaults to 2112)")
    ap.add_argument("-f", "--force", action="store_true", help="delete an existing remote file first, then upload")
    args = ap.parse_args()
    if len(args.paths) < 2:
        ap.error("need at least one local file and a destination")
    *locals_, remote = args.paths

    drive, base = parse_target(remote)
    if len(locals_) > 1 and not base.endswith("/"):
        print("trput: with several files the destination must be a directory ending in '/'", file=sys.stderr)
        return 1
    if "-" in locals_ and (len(locals_) > 1 or base.endswith("/")):
        print("trput: stdin must be the only source and needs a full remote file path", file=sys.stderr)
        return 1

    host, port = (args.host.rsplit(":", 1) + [None])[:2] if args.host else (None, None)
    status = 0
    try:
        with TR(host, port, timeout=30) as tr:
            for local in locals_:
                path = base + os.path.basename(local) if base.endswith("/") else base
                try:
                    data = sys.stdin.buffer.read() if local == "-" else open(local, "rb").read()
                except OSError as e:
                    print(f"trput: {e}", file=sys.stderr)
                    status = 1
                    continue
                try:
                    n = put(tr, drive, path, data, args.force)
                except TRError as e:
                    print(f"trput: {local}: {e}", file=sys.stderr)
                    status = 1
                    tr.reconnect()
                    continue
                print(f"{drive}:{path}: {n} bytes", file=sys.stderr)
    except TRError as e:
        print(f"trput: {e}", file=sys.stderr)
        return 1
    return status


if __name__ == "__main__":
    sys.exit(main())
