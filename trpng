#!/usr/bin/env python3
"""Convert a C64 Koala (.kla) or Art Studio (.art) picture to PNG.

usage: trpng [-s SCALE] [-f] FILE [OUT.png]     e.g. trpng pic.kla && open pic.png
OUT defaults to FILE with a .png extension. SCALE (default 3) enlarges each pixel; the
320x200 picture becomes 960x600 at the default. The format comes from the extension, the
load address or the file size. Uses the Pepto C64 palette.
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import c64img  # noqa: E402


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("file")
    ap.add_argument("out", nargs="?")
    ap.add_argument("-s", "--scale", type=int, default=3)
    ap.add_argument("-f", "--force", action="store_true", help="overwrite an existing PNG")
    a = ap.parse_args()
    out = a.out or os.path.splitext(a.file)[0] + ".png"
    if os.path.exists(out) and not a.force:
        print(f"trpng: {out} exists (use -f to overwrite)", file=sys.stderr)
        return 1
    try:
        data = open(a.file, "rb").read()
        kind = c64img.detect(data, a.file)
        c64img.write_png(out, c64img.decode(kind, data), max(1, a.scale))
    except (OSError, ValueError) as e:
        print(f"trpng: {e}", file=sys.stderr)
        return 1
    print(out, file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
